# ─────────────────────────────────────────────────────────────────────────────
# NowPayments Configuration
# Get these from: https://account.nowpayments.io/settings/api
# ─────────────────────────────────────────────────────────────────────────────

# NowPayments API Key (get from dashboard)
VITE_NOW_PAYMENTS_API_KEY=your_api_key_here

# NowPayments IPN Secret Key (for webhook verification)
VITE_NOW_PAYMENTS_IPN_SECRET=your_ipn_secret_here

# Your app URL (for payment success/cancel callbacks)
VITE_APP_URL=http://localhost:3000

# Backend URL (for webhook endpoint)
VITE_BACKEND_URL=http://localhost:3001
