# NowPayments API Keys (get from https://nowpayments.io/dashboard)
NOW_PAYMENTS_API_KEY=your_nowpayments_api_key_here
NOW_PAYMENTS_IPN_SECRET=your_ipn_webhook_secret_here

# Supabase Keys (for webhook handler)
VITE_SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# App URL (for payment callbacks)
VITE_APP_URL=http://localhost:3000
